# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string.
# Local:  postgresql://postgres:password@localhost:5432/databridge
# Neon:   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Use the databridge_readonly role in production (see src/grants.sql).
DATABASE_URL=postgresql://user:password@localhost:5432/databridge

# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
